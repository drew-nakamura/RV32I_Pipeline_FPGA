# Track only rtl/, sim/, tb/, README.md, and this file.
# Vivado, Xcelium notes, Cursor, and generated files stay local.

/*
!.gitignore
!README.md
!rtl/
!rtl/**
!sim/
!sim/**
!tb/
!tb/**
!scripts/
!scripts/**
!scripts/filelists/
!scripts/filelists/**
!docs/
!docs/**
!docs/images/
!docs/images/**
!build/
!build/**
!sw/
!sw/**

# Even inside allowed trees, skip generated simulation junk
work/
xsim.dir/
transcript
*.vcd
*.log
*.jou
*.pb
*.wdb
