# Whitelist: RTL, docs, the vendored riscv-tests, and my-tests.
# Everything else stays ignored.

*
!.gitignore
!README.md
!Makefile

!rtl/
!rtl/**

!docs/
!docs/**

!my-tests/
!my-tests/**

!riscv-tests/
!riscv-tests/**
# Generated images. Keep the add images so a git checkout can simulate.
riscv-tests/build/*
!riscv-tests/build/imem.mem
!riscv-tests/build/dmem.mem

!tb/
!tb/AGENTS.md
!tb/rv32i_selftest.S
!tb/rv32i_selftest.s

!sw/
!sw/Makefile
!sw/imem.mem
